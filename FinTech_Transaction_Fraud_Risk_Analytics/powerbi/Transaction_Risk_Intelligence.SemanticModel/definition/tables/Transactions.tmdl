table Transactions
	lineageTag: 2e6f26d9-c99d-48f3-a9f9-229c62e056ed

	measure 'Total Transactions' = COUNTROWS(Transactions)
		formatString: #,##0
		lineageTag: de35b77a-6f89-4b96-a150-19a67b3bf4df

	measure 'Transaction Volume USD' = SUM(Transactions[amount_usd])
		formatString: \$#,##0.00
		lineageTag: d2d9c1fc-d509-4e16-a955-34902cf51bab

	measure 'Approved Transactions' = CALCULATE(COUNTROWS(Transactions), Transactions[transaction_status] = "Approved")
		formatString: #,##0
		lineageTag: 7c52d5ff-2af9-4827-bc7b-c0f03708f2a7

	measure 'Approval Rate' = DIVIDE([Approved Transactions], [Total Transactions], 0)
		formatString: 0.0%
		lineageTag: 1e24dbab-bfaf-482a-bd21-c5e3a0ae7445

	measure 'Flagged Transactions' = CALCULATE(COUNTROWS(Transactions), Transactions[is_flagged] = 1)
		formatString: #,##0
		lineageTag: 3eaf6935-58f8-48cf-861f-d4fc5aa56e89

	measure 'Alert Rate' = DIVIDE([Flagged Transactions], [Total Transactions], 0)
		formatString: 0.0%
		lineageTag: 8a42818a-5723-4578-a8c8-c4a581278581

	measure 'Confirmed Fraud Cases' = CALCULATE(COUNTROWS(Transactions), Transactions[confirmed_fraud] = 1)
		formatString: #,##0
		lineageTag: 03289d29-da68-4b96-8b90-f37014a3f725

	measure 'Approved Fraud Loss USD' = CALCULATE(SUM(Transactions[amount_usd]), Transactions[confirmed_fraud] = 1, Transactions[transaction_status] = "Approved")
		formatString: \$#,##0.00
		lineageTag: 34521b1d-74cd-437d-a8f5-e37bbe2466e4

	measure 'Missed Fraud Cases' = CALCULATE(COUNTROWS(Transactions), Transactions[confirmed_fraud] = 1, Transactions[is_flagged] = 0)
		formatString: #,##0
		lineageTag: 48dd9ff7-621b-4218-85fb-71db92276f10

	measure 'Cleared Alerts' = CALCULATE(COUNTROWS(Alerts), Alerts[review_outcome] = "Cleared")
		formatString: #,##0
		lineageTag: 2e0f1bdb-a4bc-4920-a78b-2d44c8ad70a7

	measure 'Cleared Alert Rate' = DIVIDE([Cleared Alerts], COUNTROWS(Alerts), 0)
		formatString: 0.0%
		lineageTag: aca1dce7-e0b0-4f32-8ada-bfbf9e82569f

	measure 'Channel Rank by Fraud Loss' = RANKX(ALL(Transactions[channel]), [Approved Fraud Loss USD],, DESC, DENSE)
		formatString: 0
		lineageTag: b2f22fb4-ceaa-4c7f-ac17-cfb42c88ad14

