	partition Transactions = m
		mode: import
		source =
				let
					Encoded = "",
					Raw = Csv.Document(Binary.FromText(Encoded, BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Headers, {{"transaction_id",Int64.Type},{"account_id",Int64.Type},{"transaction_date",type date},{"transaction_time",type time},{"channel",type text},{"merchant_category",type text},{"amount_usd",type number},{"is_cross_border",Int64.Type},{"is_new_device",Int64.Type},{"is_high_value",Int64.Type},{"is_odd_hour",Int64.Type},{"risk_score",Int64.Type},{"is_flagged",Int64.Type},{"transaction_status",type text},{"confirmed_fraud",Int64.Type}}),
					WithMonth = Table.AddColumn(Typed, "month_label", each Date.ToText([transaction_date], "yyyy-MM"), type text)
				in WithMonth

